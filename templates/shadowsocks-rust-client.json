{
  "servers": [
    {
      "server": "__DOMAIN__",
      "server_port": 443,
      "method": "aes-256-gcm",
      "password": "__PASSWORD__",
      "plugin": "v2ray-plugin",
      "plugin_opts": "tls;host=__DOMAIN__;path=/__PATH__"
    }
  ],
  "locals": [
    {
      "local_address": "127.0.0.1",
      "local_port": __LOCAL_PORT__
    }
  ],
  "mode": "tcp_only",
  "timeout": 120,
  "fast_open": false,
  "no_delay": true,
  "ipv6_first": false
}
